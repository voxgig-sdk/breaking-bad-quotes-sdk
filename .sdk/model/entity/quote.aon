# Entity: quote

main: kit: entity: quote: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: true
      short: "The character who said the quote"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "quote"
      req: true
      short: "The quote text"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "quote"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /quotes"
            json: "{\"operationId\":\"getRandomQuote\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":[{\"author\":\"Walter White\",\"quote\":\"I am not in danger, Skyler. I AM the danger!\"}],\"schema\":{\"items\":{\"properties\":{\"author\":{\"description\":\"The character who said the quote\",\"type\":\"string\"},\"quote\":{\"description\":\"The quote text\",\"type\":\"string\"}},\"required\":[\"quote\",\"author\"],\"type\":\"object\"},\"maxItems\":1,\"minItems\":1,\"type\":\"array\"}}},\"description\":\"Successful response with a random quote\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/quotes"
          segments: [
            {
              lit: "quotes"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 5
                kind: "param"
                name: "id"
                orig: "number"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /quotes/{number}"
            json: "{\"operationId\":\"getMultipleRandomQuotes\",\"parameters\":[{\"description\":\"Number of random quotes to retrieve\",\"in\":\"path\",\"name\":\"number\",\"required\":true,\"schema\":{\"example\":5,\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":[{\"author\":\"Walter White\",\"quote\":\"I am not in danger, Skyler. I AM the danger!\"},{\"author\":\"Jesse Pinkman\",\"quote\":\"Yeah, science!\"},{\"author\":\"Walter White\",\"quote\":\"Say my name.\"},{\"author\":\"Walter White\",\"quote\":\"Tread lightly.\"},{\"author\":\"Walter White\",\"quote\":\"I won.\"}],\"schema\":{\"items\":{\"properties\":{\"author\":{\"description\":\"The character who said the quote\",\"type\":\"string\"},\"quote\":{\"description\":\"The quote text\",\"type\":\"string\"}},\"required\":[\"quote\",\"author\"],\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Successful response with multiple random quotes\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/quotes/{number}"
          rename: {
            param: {
              number: "id"
            }
          }
          segments: [
            {
              lit: "quotes"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
